{
  "name": "stacked-chat",
  "version": "1.1.0",
  "description": "Stacked Chat: AI knowledge and team comms for hospitality operators",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stripe:setup": "npx --yes tsx scripts/stripe-setup.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@types/node": "^22.20.5",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "jszip": "^3.10.1",
    "vitest": "^3.2.4"
  }
}
